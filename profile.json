{
  "project_id": "security-sast-guard",
  "stack": "python-security",
  "mode": "draft",
  "audit_level": "ultra",
  "command_firewall_overlay": {
    "deny": [
      "rm\\s+-[rRfF]{1,3}\\s+[/~]",
      "rm\\s+-rf",
      "drop\\s+database",
      "drop\\s+table",
      "truncate\\s+table",
      "format\\s+[c-zC-Z]:",
      "reg\\s+(delete|add|import|export)",
      "regedit",
      "bcdedit",
      "diskpart",
      "sfc\\s+/scannow",
      "net\\s+(user|localgroup|accounts)\\s+.*(add|delete|/add|/delete)",
      "net\\s+stop\\s+",
      "net\\s+start\\s+",
      "sc\\s+(delete|stop|start|config|create)\\s+",
      "taskkill\\s+/f",
      "shutdown\\s+(/s|/r|/h|/t|/a|-s|-r|-h)",
      "wmic\\s+(process|service|os|computersystem)\\s+(delete|call\\s+terminate|call\\s+shutdown)",
      "Invoke-Expression(\\s+|\\s*\\()",
      "iex(\\s+|\\s*\\()",
      "Invoke-WebRequest.*\\|.*Invoke-Expression",
      "IEX(\\s+|\\s*\\()",
      "Start-Process.*-Verb\\s+RunAs",
      "Set-ExecutionPolicy\\s+(Unrestricted|Bypass|RemoteSigned)",
      "powershell\\s+-enc(oded)?\\s+",
      "powershell\\s+-nop(rofile)?\\s+.*-w(indow)?\\s+hid(den)?",
      "curl.*\\|.*bash",
      "wget.*\\|.*sh",
      "bash\\s+-c",
      "sh\\s+-c\\s+['\"]",
      "dd\\s+if=",
      "mkfs\\.",
      "fdisk\\s+",
      "parted\\s+",
      "git\\s+reset\\s+--hard",
      "git\\s+checkout\\s+.*(-f\\b|--force)",
      "git\\s+checkout\\s+(--\\s+|\\.\\s*$)",
      "git\\s+restore\\s+",
      "git\\s+clean\\s+.*-[a-zA-Z]*f",
      "git\\s+branch\\s+.*-[dD]",
      "git\\s+push\\s+.*(--force|-f\\b)",
      "Format-Volume",
      "Clear-Disk",
      "Initialize-Disk",
      "Remove-Partition",
      "New-Partition",
      "Set-Partition",
      "Resize-Partition",
      "Set-MpPreference",
      "Add-MpPreference",
      "Disable-NetFirewallRule",
      "Set-NetFirewallProfile",
      "Invoke-Command",
      "Enter-PSSession",
      "Remove-Item\\s+.*-Recurse",
      "(rd|rmdir)\\s+.*(/s|/q)",
      "del\\s+.*(/s|/q)",
      "Stop-Computer",
      "Restart-Computer",
      "Stop-Service\\s+.*-Force"
    ],
    "confirm": [
      "Remove-Item",
      "\\brmdir\\b",
      "\\brd\\s+",
      "\\bdel\\s+",
      "git\\s+push\\s+(--force|-f\\b)",
      "pip\\s+install",
      "npm\\s+install",
      "choco\\s+install",
      "winget\\s+install",
      "Set-ExecutionPolicy",
      "netsh\\s+firewall",
      "netsh\\s+advfirewall",
      "schtasks\\s+(/create|/delete|/run)",
      "cacls\\s+",
      "icacls\\s+",
      "attrib\\s+"
    ]
  }
}

